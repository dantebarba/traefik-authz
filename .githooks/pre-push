#!/bin/sh
# Refuse to push commits that carry personal or secret data (see scripts/scan-secrets.sh).
# A new branch is scanned from its oldest commit that the remote does not have yet.
set -eu
zero=0000000000000000000000000000000000000000
remote=$1
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" != "$zero" ]; then
    range="$remote_sha..$local_sha"
  else
    oldest=$(git rev-list "$local_sha" --not --remotes="$remote" | tail -n 1)
    [ -n "$oldest" ] || continue
    if git rev-parse -q --verify "$oldest^" >/dev/null; then
      range="$oldest^..$local_sha"
    else
      range="$(git hash-object -t tree /dev/null)..$local_sha"
    fi
  fi
  sh scripts/scan-secrets.sh --range "$range" || status=1
done
[ $status = 0 ] || echo "pre-push: blocked; fix the findings above" >&2
exit $status
