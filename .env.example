# Copy to .env (ignored), or keep the real file in the sibling "traefik-authz-env" directory
# next to the main checkout, which .envrc loads automatically. Override its location with
# TRAEFIK_AUTHZ_ENV_DIR.

ADMIN_EMAILS=admin@example.com
USER_HEADER=X-Forwarded-User
MIDDLEWARE_NAME=traefik-authz
DB_PATH=./data/authz.db
LISTEN_ADDR=127.0.0.1:8080
DOCKER_HOST=unix:///var/run/docker.sock
RESYNC_INTERVAL=5m

# --- git identity for commits to this public repository ---
GIT_USER_NAME=
GIT_USER_EMAIL=
