repo_root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$PWD/.git")")
env_dir="${TRAEFIK_AUTHZ_ENV_DIR:-$(dirname "$repo_root")/${repo_root##*/}-env}"
export TRAEFIK_AUTHZ_ENV_DIR="$env_dir"
watch_file "$env_dir/.env" "$env_dir/.envrc" .env .envrc.local
source_env_if_exists "$env_dir/.envrc"
dotenv_if_exists "$env_dir/.env"
dotenv_if_exists .env
source_env_if_exists .envrc.local
PATH_add bin
if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && [ "$(git config core.hooksPath)" != .githooks ]; then
  git config core.hooksPath .githooks
fi
if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && [ -n "${GIT_USER_EMAIL:-}" ]; then
  git config user.email "$GIT_USER_EMAIL"
  [ -z "${GIT_USER_NAME:-}" ] || git config user.name "$GIT_USER_NAME"
fi
